# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file to GitHub — it's in .gitignore for a reason.

PORT=3000

# Database connection
DB_HOST=localhost
DB_PORT=5432
DB_USER=mindspace_user
DB_PASSWORD=your_db_password_here
DB_NAME=mindspace_db

# JWT — use a long, random string in real .env. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Gemini API — used for Phase 4 AI content screening (classifies new
# posts as safe/harmful/crisis). Get a free key at aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
